# ~/.config/containers/systemd/opencode-web.container
[Unit]
Description=OpenCode AI coding agent (Web)
After=network-online.target podman.socket
Wants=network-online.target
Requires=podman.socket

[Container]
Image=ghcr.io/22p/dsh:latest
ContainerName=opencode-web
AutoUpdate=registry
Environment=TZ=Asia/Shanghai
PublishPort=127.0.0.1:4097:4097
Volume=dsh:/root
Exec=npx -y @opencode/cli@latest serve --hostname 0.0.0.0 --port 4097

SecurityLabelDisable=true
Volume=%t/podman/podman.sock:/run/podman/podman.sock

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
